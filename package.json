{
  "name": "svg2pdf.js",
  "version": "2.7.0",
  "description": "A javascript-only SVG to PDF conversion utility that runs in the browser leveraging jsPDF",
  "keywords": [
    "javascript",
    "pdf",
    "svg"
  ],
  "homepage": "https://github.com/yWorks/svg2pdf.js#readme",
  "bugs": {
    "url": "https://github.com/yWorks/svg2pdf.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "yFiles for HTML Support Team",
    "email": "yfileshtml@yworks.com",
    "url": "https://www.yworks.com/yfileshtml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yWorks/svg2pdf.js.git"
  },
  "files": [
    "dist/**",
    "types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/svg2pdf.umd.min.js",
  "module": "dist/svg2pdf.es.min.js",
  "browser": "dist/svg2pdf.es.min.js",
  "types": "types.d.ts",
  "scripts": {
    "version": "npm run build && git add -A dist",
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:update": "vitest run -u",
    "test:ci": "vitest run -u",
    "playwright:install": "playwright install",
    "createreferences": "node test/common/reference-server.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint -f=agent"
  },
  "dependencies": {
    "cssesc": "^3.0.0",
    "font-family-papandreou": "^0.2.0-patch1",
    "specificity": "^0.4.1",
    "svgpath": "^2.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^26.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "chai": "^4.2.0",
    "chalk": "^4.1.0",
    "cross-env": "^7.0.2",
    "cssesc": "^3.0.0",
    "exorcist": "^2.0.0",
    "font-family-papandreou": "^0.2.0-patch1",
    "jspdf": "^4.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rollup": "^4.22.4",
    "rollup-plugin-license": "^3.5.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "jspdf": "^4.0.0 || ^3.0.0 || ^2.0.0"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    }
  }
}
